# Copy this file to .env and fill in OPENAI_API_KEY at minimum. Everything
# else has a working default for local/grading use.

# Postgres superuser password. Used only by the `db` and `migrate` services
# (migrate runs schema.sql + the loader as this user). The app itself never
# connects as this user — see README "Safety" and scripts/schema.sql.
POSTGRES_PASSWORD=devpassword

# Required. The agent's own LLM key — this is the only secret you must
# supply for the agent to actually answer questions.
OPENAI_API_KEY=""

# Optional overrides (defaults shown):
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
ROW_CAP=5000
LOG_LEVEL=INFO
